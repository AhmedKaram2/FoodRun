{
  "name": "intrvioo-mobile",
  "version": "1.7.2",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output build/android/index.android.bundle --assets-dest build/android",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output build/ios/main.jsbundle --assets-dest build/ios"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.10.1",
    "react-native-svg": "15.15.5"
  },
  "devDependencies": {
    "@react-native-community/cli": "20.0.2",
    "@react-native-community/cli-platform-android": "20.0.2",
    "@react-native-community/cli-platform-ios": "20.0.2",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.14",
    "jest": "29.7.0",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.3"
  }
}
